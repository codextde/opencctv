{
  "expo": {
    "name": "OpenCCTV",
    "slug": "opencctv",
    "owner": "codext-gmbh",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "opencctv",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0D10",
    "ios": {
      "bundleIdentifier": "de.codext.opencctv",
      "buildNumber": "1",
      "supportsTablet": false,
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "de"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "OpenCCTV connects to your own OpenCCTV server in your home network to show your cameras.",
        "NSPhotoLibraryAddUsageDescription": "OpenCCTV saves snapshots and clips you export from your cameras to your photo library."
      }
    },
    "android": {
      "package": "de.codext.opencctv",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0B0D10",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OpenCCTV uses the camera only to scan the pairing QR code shown by your OpenCCTV server.",
          "microphonePermission": "OpenCCTV uses the microphone only while you hold the talk button to speak through a camera's speaker.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "OpenCCTV saves snapshots and clips you export from your cameras to your photo library.",
          "granularPermissions": []
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OpenCCTV uses Face ID to unlock the app when the app lock is turned on."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#14B8A6"
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      "expo-sqlite",
      "expo-web-browser",
      "expo-localization",
      "expo-font",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-scene-lifecycle.js"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "238ef94f-c571-4eb6-bad9-88598730be2a"
      }
    }
  }
}
